<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
        <style>
            html,
            body {
                margin: 0;
                padding: 0;
                min-height: 100vh;
            }
            body {
                font-family: monospace;
                background: #fff;
                color: #999;
                font-size: 0.9rem;
                padding: 1em;
            }
            pre {
                margin: 0;
                white-space: pre-wrap;
                word-break: break-all;
                line-height: 1.5;
            }
            .error {
                color: #c33;
            }
        </style>
    </head>
    <body>
        <pre id="out">gathering intimate systems…</pre>
        <script src="/rpc.js"></script>
        <script>
            callTokenUri(7)
                .then(function (t) {
                    document.getElementById("out").textContent = t;
                })
                .catch(function (err) {
                    document.getElementById("out").className = "error";
                    document.getElementById("out").textContent = err.message;
                });
        </script>
    </body>
</html>
